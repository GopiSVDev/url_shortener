# Database Credentials & Ports
POSTGRES_DB=urlshortenerdb
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_db_password
POSTGRES_PORT=5432

# pgAdmin Credentials & Port
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=your_pgadmin_password
PGADMIN_PORT=5050

# Application Port
BACKEND_PORT=4000

# JWT Secrets & Expiration
JWT_SECRET=your_base64_encoded_256_bit_jwt_secret_key_here
JWT_ACCESS_TOKEN_EXPIRATION_MS=86400000
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000

# Application Security & CORS
SECURITY_PUBLIC_ENDPOINTS=/api/auth/**,/shorten,/{code},/qr/{code}
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Your domain
APP_BASE_URL=

# Frontend
# Signs the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=your_session_secret_here
# Public URL used for canonical links, sitemap and robots.txt (e.g. https://example.com).
# Leave empty to use the request origin until you have a domain.
SITE_URL=
